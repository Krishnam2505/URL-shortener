# The port our Express server will listen on
PORT=8000

# The connection string for our PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortlink

# Controls how many logical cache shards the consistent hash ring distributes keys across — we simulate shards as separate Redis DB numbers on one local instance for development, but in production these would be separate physical Redis nodes.
REDIS_SHARD_COUNT=3

# The connection URLs for each of our Redis shards
REDIS_SHARD_0_URL=redis://localhost:6379/0
REDIS_SHARD_1_URL=redis://localhost:6379/1
REDIS_SHARD_2_URL=redis://localhost:6379/2

# How long (in seconds) cached original URLs will live in Redis before expiring
CACHE_TTL_SECONDS=3600

# The maximum number of tokens a client can accumulate in their token bucket for rate limiting (max burst size)
RATE_LIMIT_CAPACITY=10

# How many tokens are added to a client's bucket per second (sustained rate)
RATE_LIMIT_REFILL_PER_SEC=1

# The URL of our frontend React application, used to configure CORS so the frontend can safely call the backend API
CLIENT_URL=http://localhost:5173
